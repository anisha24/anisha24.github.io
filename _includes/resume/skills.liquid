<div class="skills-horizontal">
  {% for content in data[1] %}
    <div class="skill-category mb-4" title="{{ content.level }}">
      <div class="skill-header d-flex align-items-center mb-2">
        {% if content.icon %}
          <i class="{{ content.icon }} me-4"></i>&nbsp;&nbsp;&nbsp;
        {% endif %}
        <h5 class="mb-0">{{ content.name }}</h5>
      </div>
      <div class="skill-tags d-flex flex-wrap gap-2">
        {% for item in content.keywords %}
          <span class="badge bg-light text-dark border">{{ item }}</span>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</div>
